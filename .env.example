# ============================================================
#  VARIABLES DE ENTORNO — NUNCA subas este archivo a git
#  Copia este archivo como .env.local para desarrollo
# ============================================================

# --- Clerk (Autenticación) ---
# Obtenlas en: https://dashboard.clerk.com → tu app → API Keys
PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_XXXXXXXXXX
CLERK_SECRET_KEY=sk_test_XXXXXXXXXX

# ID del rol de directora en Clerk (se configura en Clerk Dashboard → Roles)
DIRECTOR_ROLE_ID=rol_XXXXXXXXXX

# --- Supabase (Base de datos) ---
# Obtenlas en: https://supabase.com → tu proyecto → Settings → API
# IMPORTANTE: Usa SOLO la service_role key en el servidor, NUNCA en el cliente
PUBLIC_SUPABASE_URL=https://XXXXXXXXXX.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJXXXXXXXXXX   # Solo servidor — acceso total a la DB
PUBLIC_SUPABASE_ANON_KEY=eyJXXXXXXXXXX    # Solo para operaciones públicas (ninguna en este proyecto)

# --- App ---
# Horario de entrada permitido (minutos de gracia antes de marcar tardanza)
ENTRY_GRACE_MINUTES=10
# Hora de entrada esperada en formato HH:MM (24h)
ENTRY_TIME=07:30
